{
  "rust-analyzer.linkedProjects": [
    "Cargo.toml",
    "dvs-rpkg/src/rust/Cargo.toml"
  ],
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.cargo.targetDir": "${workspaceFolder}/dvs-rpkg/ra-target",
  "rust-analyzer.files.excludeDirs": [
    "dvs-rpkg/vendor",
    "dvs-rpkg/src/rust/vendor",
    "dvs-rpkg/src/rust/target",
    "dvs-rpkg/rust-target",
    "dvs-rpkg/ra-target",
    "dvs-rpkg/rv"
  ],
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": [
    "--",
    "-W",
    "clippy::all"
  ],
  // Integrated terminals only. NOT_CRAN lets a bare testthat::test_dir() or
  // test_file() run the skip_on_cran() cases (the gctorture tests).
  // devtools::test() sets it itself. RV_LINK_MODE has rv link packages from
  // its cache instead of copying them. CARGO_PROFILE stays release: an
  // unoptimized build hashes far slower.
  "terminal.integrated.env.osx": {
    "CARGO_TARGET_DIR": "${workspaceFolder}/dvs-rpkg/rust-target",
    "NOT_CRAN": "true",
    "RV_LINK_MODE": "symlink"
  },
  "terminal.integrated.env.linux": {
    "CARGO_TARGET_DIR": "${workspaceFolder}/dvs-rpkg/rust-target",
    "NOT_CRAN": "true",
    "RV_LINK_MODE": "symlink"
  },
  "terminal.integrated.env.windows": {
    "CARGO_TARGET_DIR": "${workspaceFolder}/dvs-rpkg/rust-target",
    "NOT_CRAN": "true"
  },
  "[rust]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "files.associations": {
    "*.in": "plaintext",
    "Cargo.toml.in": "toml",
    "Makevars.in": "makefile",
    "Makevars.win.in": "makefile",
    "configure.ac": "autoconf",
    "NAMESPACE": "r",
    "DESCRIPTION": "yaml"
  },
  // The scaffold's .gitignore lists R/*-wrappers.R, which dvs tracks. Keep
  // the generated wrappers visible in the explorer and in search.
  "explorer.excludeGitIgnore": false,
  "files.exclude": {
    "**/*-wrappers.R": false,
    "**/target": true,
    "**/rust-target": true,
    "**/ra-target": true,
    "**/autom4te.cache": true,
    "**/*.o": true,
    "**/*.so": true,
    "**/*.a": true
  },
  // Search honours ignore files even for tracked files, which would hide
  // R/dvs-wrappers.R. They are off, so the large ignored directories are
  // excluded here instead.
  "search.useIgnoreFiles": false,
  "search.useParentIgnoreFiles": false,
  "search.useGlobalIgnoreFiles": false,
  "search.exclude": {
    "**/*-wrappers.R": false,
    "**/target": true,
    "**/rust-target": true,
    "**/ra-target": true,
    "**/ra_target": true,
    "**/autom4te.cache": true,
    "**/*.Rcheck": true,
    "**/Cargo.lock": true,
    "dvs-rpkg/vendor": true,
    "dvs-rpkg/src/rust/vendor": true,
    "dvs-rpkg/rv/library": true,
    "dist": true,
    "datasets": true,
    ".claude/worktrees": true,
    ".miniextendr": true
  },
  "C_Cpp_Runner.msvcBatchPath": ""
}
