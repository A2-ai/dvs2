configure~
autom4te.cache
config.log
config.status
.cargo/config.toml
src/Makevars
# Note: Makevars.win is a static file (uses `include Makevars`), tracked in git
src/*-wrappers.R

# Built artifacts
src/*.o
src/*.so
src/*.dll

# Cargo target directories
# These MUST be outside src/ to avoid pkgbuild scanning generated .rs files
rust-target/
ra-target/
# Legacy locations (inside src/, causes pkgbuild issues)
src/rust/ra_target/
src/rust/target/

# Vendor tarball + compression stamp (regenerated by `just vendor` at
# release time and in CI; not tracked — would create binary merge conflicts
# and ~16 MB/commit bloat).
inst/vendor.tar.xz
inst/.vendor.tar.xz.cksum

# Intermediary files from configure.ac
.vendor-tarball-staging/

# Vendored crates (large, auto-generated by cargo vendor)
vendor/
R/*-wrappers.R
src/rust/wasm_registry.rs
