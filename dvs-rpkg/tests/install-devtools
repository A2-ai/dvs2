#!/usr/bin/env bash
set -euo pipefail
trap 'printf "ERROR at %s:%d\n" "${BASH_SOURCE[0]}" "$LINENO" >&2' ERR

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RPKG_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
ROOT_DIR="$(cd "${RPKG_DIR}/.." && pwd)"

REMOTE_REPO="${DVS_REMOTE_REPO:-A2-ai/dvs2}"

cd "$ROOT_DIR"
SHA="$(git rev-parse HEAD)"
echo "=== HEAD: $SHA ==="

git fetch origin --quiet
if ! git branch -r --contains "$SHA" 2>/dev/null | grep -q '^[[:space:]]*origin/'; then
  echo "SKIP: $SHA is not on origin yet — push the branch before running this test"
  exit 0
fi

# The scratch directory is not named TMPDIR. TMPDIR is exported, so the name
# would hand this directory to every child process as its temp directory, and
# a server one of them starts (sccache) keeps it after the trap deletes it.
WORK_DIR="$(mktemp -d)"
LIB="$WORK_DIR/Rlib"
mkdir -p "$LIB"
trap 'rm -rf "$WORK_DIR"' EXIT

echo "=== devtools::install_github $REMOTE_REPO@$SHA, subdir=dvs-rpkg ==="
Rscript --vanilla - <<RSCRIPT
.libPaths(c("$LIB", .libPaths()))
if (!requireNamespace("devtools", quietly = TRUE)) {
  install.packages("devtools", lib = "$LIB", repos = "https://cloud.r-project.org")
}
devtools::install_github(
  "$REMOTE_REPO",
  subdir = "dvs-rpkg",
  ref = "$SHA",
  upgrade = "never",
  lib = "$LIB"
)
RSCRIPT

echo "=== FFI smoke: dvs_init ==="
SMOKE_ROOT="$(mktemp -d "$WORK_DIR/smoke-root.XXXXXX")"
SMOKE_STORE="$(mktemp -d "$WORK_DIR/smoke-store.XXXXXX")"
Rscript -e "
  .libPaths(c('$LIB', .libPaths()))
  dvs::dvs_init('$SMOKE_STORE', root_dir = '$SMOKE_ROOT')
  cat('dvs FFI smoke OK\n')
"
rm -rf "$SMOKE_ROOT" "$SMOKE_STORE"

echo "PASS"
