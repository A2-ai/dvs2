#!/usr/bin/env bash
set -euo pipefail
trap 'printf "ERROR at %s:%d\n" "${BASH_SOURCE[0]}" "$LINENO" >&2' ERR

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RPKG_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
ROOT_DIR="$(cd "${RPKG_DIR}/.." && pwd)"

TMPDIR="$(mktemp -d)"
LIB="$TMPDIR/Rlib"
mkdir -p "$LIB"

trap 'rm -rf "$TMPDIR"' EXIT

# The release path: minirextendr's tarball build is the one step that
# vendors. It restores the source tree on exit.
echo "=== miniextendr_build_tarball (vendor, build, restore) ==="
cd "$ROOT_DIR"
RV_LIB="$RPKG_DIR/$(cd "$RPKG_DIR" && rv library)"
BEFORE="$(shasum dvs-rpkg/src/rust/Cargo.toml dvs-rpkg/src/rust/Cargo.lock)"
R_LIBS="$RV_LIB" Rscript -e 'minirextendr::miniextendr_build_tarball("dvs-rpkg", dest_path = commandArgs(TRUE)[[1]])' "$TMPDIR"
TARBALL="$(find "$TMPDIR" -maxdepth 1 -name 'dvs_*.tar.gz' -print -quit)"
test -n "$TARBALL"
echo "Built: $TARBALL"

echo "=== source tree restored ==="
test "$(shasum dvs-rpkg/src/rust/Cargo.toml dvs-rpkg/src/rust/Cargo.lock)" = "$BEFORE"
test ! -e dvs-rpkg/inst/vendor.tar.xz
test ! -e dvs-rpkg/src/rust/.Cargo.toml.prefreeze

echo "=== R CMD INSTALL --library=$LIB (offline) ==="
cd "$TMPDIR"
CARGO_HOME="$TMPDIR/cargo-home" \
CARGO_NET_OFFLINE=1 \
  R CMD INSTALL --no-test-load --library="$LIB" "$TARBALL"

echo "=== FFI smoke: dvs_init ==="
SMOKE_ROOT="$(mktemp -d)"
SMOKE_STORE="$(mktemp -d)"
Rscript -e "
  .libPaths(c('$LIB', .libPaths()))
  dvs::dvs_init('$SMOKE_STORE', root_dir = '$SMOKE_ROOT')
  cat('dvs FFI smoke OK\n')
"
rm -rf "$SMOKE_ROOT" "$SMOKE_STORE"

echo "PASS"
